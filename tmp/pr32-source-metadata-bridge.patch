+    current_status: str(meta.current_status),
+    last_checked_at: str(meta.last_checked_at),
+    retrieved_at: str(meta.retrieved_at, meta.official_retrieved_at),
+    canonical_document_key: str(meta.canonical_document_key),
+    canonical_version_key: str(meta.canonical_version_key),
+    provider_id: str(meta.provider_id),
+    provider: str(meta.provider, meta.official_provider),
+    official_origin_verified: officialOrigin,
+    document_identity_verified: identityVerified,
+    content_verified: contentVerified,
+    substantive_use_allowed: substantiveAllowed,
+    verification_level: verificationLevel,
+    verification_status: verificationStatus,
+    actuality_status: actualityStatus,
+  };
+}
