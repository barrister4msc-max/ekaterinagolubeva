+import { describe, expect, test } from "bun:test";
+import { enrichSources } from "./enrich.ts";
+
+function merged(metadata: Record<string, unknown>, officialUrl: string | null = null): any {
+  return {
+    bucket: "laws",
+    source_table: "legal_knowledge_chunks",
+    source_id: "source-1",
+    source_type: "federal_law",
+    title: "Федеральный закон № 425-ФЗ",
+    official_url: officialUrl,
+    citation: "425-ФЗ",
+    snippet: "Текст закона",
+    metadata,
+    code: null,
+    article: null,
+    part: null,
+    case_number: null,
+    letter_number: null,
+    letter_date: null,
+    scores: { semantic: 0.8, keyword: 0.8, priority: 0.5, relevance: 1, final: 0.8 },
+    merged_from: [{ source_table: "legal_knowledge_chunks", source_id: "source-1" }],
+    appearances: 1,
+  };
+}
+
+describe("Canonical Source Metadata Bridge", () => {
+  test("projects canonical registry metadata into TrustedSource without changing source_ref", () => {
+    const [source] = enrichSources([
+      merged({
+        authority_name: "Государственная Дума",
+        authority_level: "primary",
+        publication_date: "2025-11-28",
+        effective_from: "2026-01-01",
+        effective_to: null,
+        revision_date: "2025-11-28",
+        is_official: true,
+        current_status: "active",
+        verification_status: "verified",
+        last_checked_at: "2026-08-17T10:00:00.000Z",
+        retrieved_at: "2026-08-17T09:00:00.000Z",
+        canonical_document_key: "ru:laws:document:425-фз:2025-11-28",
+        canonical_version_key: "ru:laws:document:425-фз:2025-11-28:v1",
+      }),
+    ]);
+
+    expect(source.source_ref).toBe("law:source-1");
+    expect(source.authority_name).toBe("Государственная Дума");
+    expect(source.authority_level).toBe("primary");
+    expect(source.effective_from).toBe("2026-01-01");
+    expect(source.current_status).toBe("active");
+    expect(source.verification_status).toBe("verified");
+    expect(source.canonical_document_key).toBe("ru:laws:document:425-фз:2025-11-28");
+    expect(source.canonical_version_key).toBe("ru:laws:document:425-фз:2025-11-28:v1");
+  });
+
+  test("preserves PR32 official safety semantics instead of replacing them with URL heuristics", () => {
+    const [source] = enrichSources([
+      merged(
+        {
+          provider_id: "pravo",
+          official_provider: "publication.pravo.gov.ru",
+          official_retrieved_at: "2026-08-17T09:00:00.000Z",
+          official_verification: {
+            official_origin_verified: true,
+            document_identity_verified: true,
+            content_verified: false,
+            actuality_status: "verified",
+            substantive_use_allowed: false,
+            verification_level: "identity",
+          },
+        },
+        "https://publication.pravo.gov.ru/document/0001",
+      ),
+    ]);
+
+    expect(source.provider_id).toBe("pravo");
+    expect(source.provider).toBe("publication.pravo.gov.ru");
+    expect(source.official_origin_verified).toBe(true);
+    expect(source.document_identity_verified).toBe(true);
+    expect(source.content_verified).toBe(false);
+    expect(source.substantive_use_allowed).toBe(false);
+    expect(source.verification_level).toBe("identity");
+    expect(source.verification_status).toBe("identity");
+    expect(source.actuality_status).toBe("verified");
+  });
+
+  test("keeps legacy URL-based status only as fallback when canonical metadata is absent", () => {
+    const [source] = enrichSources([
+      merged({}, "https://publication.pravo.gov.ru/document/legacy"),
+    ]);
+    expect(source.verification_status).toBe("needs_check");
+    expect(source.actuality_status).toBe("requires_actuality_check");
+  });
+});
