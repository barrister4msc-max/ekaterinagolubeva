 // ---------- Build trusted source set from merged registry -------------------
 
+function sourceMetadataBridge(s: MergedSource) {
+  const meta = (s.metadata ?? {}) as Record<string, unknown>;
+  const safety = (meta.official_verification ?? meta.safety) as Record<string, unknown> | undefined;
+  const str = (...values: unknown[]): string | null => {
+    for (const value of values) {
+      if (typeof value === "string" && value.trim()) return value.trim();
+    }
+    return null;
+  };
+  const bool = (...values: unknown[]): boolean | null => {
+    for (const value of values) if (typeof value === "boolean") return value;
+    return null;
+  };
+
+  const verificationLevel = str(meta.verification_level, safety?.verification_level);
+  const verificationStatus =
+    str(meta.verification_status, verificationLevel) ??
+    (s.official_url ? "needs_check" : "missing_url");
+  const actualityStatus =
+    str(meta.actuality_status, safety?.actuality_status) ??
+    (s.official_url ? "requires_actuality_check" : "requires_manual_verification");
+
+  const officialOrigin = bool(meta.official_origin_verified, safety?.official_origin_verified) ?? false;
+  const identityVerified = bool(meta.document_identity_verified, safety?.document_identity_verified) ?? false;
+  const contentVerified = bool(meta.content_verified, safety?.content_verified) ?? false;
+  const substantiveAllowed = bool(meta.substantive_use_allowed, safety?.substantive_use_allowed) ?? false;
+
+  return {
+    authority_name: str(meta.authority_name, meta.signatory_authority),
+    authority_level: str(meta.authority_level),
+    publication_date: str(meta.publication_date),
+    effective_from: str(meta.effective_from),
+    effective_to: str(meta.effective_to),
+    revision_date: str(meta.revision_date, meta.revision),
