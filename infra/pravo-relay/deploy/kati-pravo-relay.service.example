[Unit]
Description=KATI LAWYER Pravo relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kati
Group=kati
WorkingDirectory=/opt/kati-lawyer/pravo-relay
EnvironmentFile=/etc/kati-lawyer/pravo-relay.env
ExecStart=/usr/bin/deno run --no-prompt --allow-env=KATI_RELAY_TOKEN --allow-net=127.0.0.1:8787,publication.pravo.gov.ru:443 server.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
